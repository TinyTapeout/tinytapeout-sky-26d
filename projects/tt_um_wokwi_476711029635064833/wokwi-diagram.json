    {
      "type": "wokwi-text",
      "id": "title",
      "left": 40,
      "top": -250,
      "attrs": {
        "text": "TINY TAPEOUT: 8-BIT U + V  ->  SUM[7:0]  |  CARRY LED = SIMULATION ONLY"
      }
    },
    {
      "type": "wokwi-text",
      "id": "guide",
      "left": -565,
      "top": -205,
      "attrs": {
        "text": "U switch bank -> dedicated ui[0..7].  V switch bank -> uio[0..7] (INPUT mode). SUM -> uo[0..7]."
      }
    },
    {
      "type": "wokwi-text",
      "id": "guide2",
      "left": -565,
      "top": -167,
      "attrs": {
        "text": "Each full adder: p=U XOR V; SUM=p XOR carry_in; carry_out=(U AND V) OR (p AND carry_in)."
      }
    },
    {
      "type": "wokwi-text",
      "id": "note_carry",
      "left": 1115,
      "top": 2420,
      "attrs": {
        "text": "CARRY8: WOKWI ONLY. No chip pin allocated; final carry logic may be optimized out in GDS."
      }
    },
